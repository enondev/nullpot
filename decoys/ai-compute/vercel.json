{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/admin", "status": 404 },
    { "src": "/.env", "status": 404 },
    { "src": "/phpmyadmin", "status": 404 },
    { "src": "/server-status", "status": 404 },
    { "src": "/.git", "status": 404 },
    { "src": "/wp-admin", "status": 404 },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
