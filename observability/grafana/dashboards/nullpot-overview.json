          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showThresholdGauge": false,
        "showThresholdLabels": false,
        "text": {},
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "cellGap": null
      },
      "targets": [
        {
          "expr": "nullpot_channel_size",
          "refId": "A",
          "legendFormat": "{{ channel }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 4096,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3686 },
              { "color": "red", "value": 3891 }
            ]
