      "title": "Edge API Status",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "cellGap": null,
        "showPercentageChange": false
      },
      "targets": [
        {
          "expr": "up{job=\"nullpot-edge-api\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Trap Events per Module",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 3 },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(nullpot_trap_events_total[1m])",
          "refId": "A",
          "legendFormat": "{{ module }} - {{ event_type }}"
        }
      ]
    },
