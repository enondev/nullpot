{
  "id": null,
  "uid": "nullpot-overview",
  "title": "nullpot - Threat & Abuse Intelligence Platform",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Sensor Status",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "cellGap": null,
        "showPercentageChange": false
      },
      "targets": [
        {
          "expr": "up{job=\"nullpot-sensor\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Aggregator Status",
      "type": "stat",
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "cellGap": null,
        "showPercentageChange": false
      },
      "targets": [
        {
          "expr": "up{job=\"nullpot-aggregator\"}",
          "refId": "A"
        }
      ]
    },
    {
